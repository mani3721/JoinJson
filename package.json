{
  "name": "private-json-merger",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "node scripts/sync-security.mjs && node scripts/build-editors.mjs && node scripts/build-site.mjs",
    "test:editors": "node --test tests/codemirror.test.mjs",
    "test:ai": "node --test tests/ai-assistant.test.mjs tests/ai-vercel.test.mjs",
    "start": "node --env-file=.env server/ai-server.mjs",
    "test:python": "node --test tests/json-to-python.test.mjs tests/json-to-python-editors.test.mjs tests/tool-routes.test.mjs",
    "test:typescript": "node --test tests/json-to-typescript.test.mjs tests/json-to-typescript-editors.test.mjs tests/tool-menu.test.mjs tests/tool-routes.test.mjs",
    "test:zod": "node --test tests/json-to-zod.test.mjs tests/json-to-zod-editors.test.mjs",
    "test:urls": "node --test tests/json-url.test.mjs",
    "test:flow": "node --test tests/three-step.test.mjs",
    "test:ads": "node --test tests/adsense.test.mjs",
    "audit:export": "node scripts/audit-deliverables.mjs",
    "audit:headers": "node scripts/sync-security.mjs",
    "test:audit": "node --test tests/home-audit.test.mjs tests/home-performance.test.mjs tests/startup-performance.test.mjs tests/security.test.mjs",
    "test:performance": "node tests/home-performance-browser.mjs",
    "test": "node --test tests/*.test.mjs tests/*.test.js",
    "test:yaml": "node --test tests/json-to-yaml.test.mjs tests/json-to-yaml-editors.test.mjs tests/tool-menu.test.mjs tests/tool-routes.test.mjs",
    "test:diff": "node --test tests/json-diff.test.mjs tests/json-diff-editors.test.mjs tests/tool-routes.test.mjs tests/tool-menu.test.mjs",
    "test:curl": "node --test tests/curl-to-js.test.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/language": "^6.11.0",
    "@codemirror/lint": "^6.8.0",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "js-yaml": "4.3.2",
    "jsdom": "^26.0.0",
    "jsondiffpatch": "0.7.6",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=20.6"
  }
}
